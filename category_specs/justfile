validate-super-categories:
    #!/usr/bin/env bash
    set -uo pipefail
    cd {{justfile_directory()}}
    banned_status=0
    constructor_status=0
    graph_status=0
    just --justfile {{justfile()}} check-banned-spec-patterns || banned_status=$?
    just --justfile {{justfile()}} check-constructor-name-inventory || constructor_status=$?
    sage validators/super_categories_validator.py
    graph_status=$?
    if ((banned_status != 0 || constructor_status != 0 || graph_status != 0)); then
        exit 1
    fi
