default: _clean-generated-artifacts
    @just --list

[private]
_clean-generated-artifacts:
    #!/usr/bin/env python3
    import shutil
    from pathlib import Path

    root = Path(r"{{justfile_directory()}}")

    for pattern in ("*.sage.py", "*.orig"):
        for path in root.rglob(pattern):
            if path.is_file() or path.is_symlink():
                path.unlink()

    for dirname in ("__pycache__", ".serena"):
        directories = sorted(root.rglob(dirname), key=lambda path: len(path.parts), reverse=True)
        for path in directories:
            if path.is_dir():
                shutil.rmtree(path)

    directories = sorted(
        (path for path in root.rglob("*") if path.is_dir()),
        key=lambda path: len(path.parts),
        reverse=True,
    )
    for path in directories:
        try:
            path.rmdir()
        except OSError:
            pass

smoke: _clean-generated-artifacts
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{justfile_directory()}}
    cleanup() {
        just --justfile {{justfile()}} _clean-generated-artifacts >/dev/null
    }
    trap cleanup EXIT

    smoke_files=(
        "cat/smoketest.sage"
        "homsets/smoketest.sage"
        "sets/smoketest.sage"
        "posets/smoketest.sage"
        "topological_spaces/smoketest.sage"
        "algebras/smoketest.sage"
        "rings/smoketest.sage"
        "modules/smoketest.sage"
    )

    failures=()
    for test_file in "${smoke_files[@]}"; do
        echo "==> sage ${test_file}"
        if ! sage "${test_file}"; then
            failures+=("${test_file}")
        fi
    done

    if ((${#failures[@]})); then
        printf '\nSmoke files with failures:\n'
        printf '  %s\n' "${failures[@]}"
        exit 1
    fi

test: smoke _clean-generated-artifacts
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{justfile_directory()}}
    cleanup() {
        just --justfile {{justfile()}} _clean-generated-artifacts >/dev/null
    }
    trap cleanup EXIT

    test_dirs=(
        "cat/tests"
        "homsets/tests"
        "sets/tests/regression"
        "sets/tests/new_spec"
        "sets/tests/sage_gaps"
        "topological_spaces/tests"
        "algebras/tests"
        "rings/tests/regression"
        "rings/tests/new_spec"
        "rings/tests/sage_gaps"
        "modules/tests"
    )

    while IFS= read -r test_file; do
        echo "==> sage ${test_file}"
        sage "${test_file}"
    done < <(
        find "${test_dirs[@]}" -type f -name '*.sage' \
            ! -name 'smoketest.sage' \
            | sort
    )
